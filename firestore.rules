rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStudioAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'swayampandey099@gmail.com'
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isStudioAdmin();
      allow write: if isOwner(userId) || isStudioAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      // Allow public creation of booking submissions from prospective clients
      allow create: if request.resource.data.clientEmail is string 
                    && request.resource.data.clientName is string;

      // Allow users to read and manage their own bookings, or Studio Owner to read all
      allow read: if isStudioAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );

      allow update, delete: if isStudioAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}

